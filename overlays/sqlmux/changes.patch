+func TestWithDatabasePreservesCredentialsAndTLS(t *testing.T) {
+	for _, scheme := range []string{"gaussdb", "opengauss", "postgres", "postgresql"} {
+		dsn := scheme + "://app:p%40ss@db.example:30100/original?dbname=override&sslmode=verify-full"
