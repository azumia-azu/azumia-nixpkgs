--- /dev/null
+++ b/internal/db/gaussdb/catalog_test.go
@@ -0,0 +1,130 @@ func fixture(t *testing.T) (*Conn, string) {
+//go:build integration
+
+package gaussdb
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"reflect"
+	"slices"
+	"strings"
+	"sync/atomic"
+	"testing"
+
+	"github.com/kackerx/sqlmux/internal/db"
+)
+
+var schemaID atomic.Uint64
+var engine = Engine{}
+
+func fixture(t *testing.T) (*Conn, string) {
+	t.Helper()
+	c := connect(t, false)
+	schema := fmt.Sprintf("sqlmux_gauss_%d_%d", os.Getpid(), schemaID.Add(1))
+	query(t, c, "create schema "+engine.Quote(schema))
+	t.Cleanup(func() { query(t, c, "drop schema "+engine.Quote(schema)+" cascade") })
+	query(t, c, "set search_path to "+engine.Quote(schema))
+	_, err := c.Exec(context.Background(), `
+create type state as enum ('pending', 'done');
+create table parent (a int, b int, primary key (b, a)) with (storage_type=astore);
+create table items (
+ id int primary key, code text not null, amount numeric(12,2), note text,
+ state state default 'pending', a int, b int,
+ generated int generated always as (id + 1) stored,
+ foreign key (b, a) references parent(b, a)) with (storage_type=ustore);
+create unique index items_code on items using ubtree(code) include(note);
+create unique index items_nullable on items(note);
+create index items_expression on items((lower(code)));
+create view item_view as select id, code from items;
+create materialized view item_summary with (storage_type=astore) as select count(*) as n from parent;
+create sequence item_seq;
+create function sample() returns text as $$ select E'a\\b'::text $$ language sql;
+insert into items(id, code, amount, note) values (1, 'first', 1.50, 'before'), (2, 'second', 2.50, null);
+`, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return c, schema
+}
+
+func TestCatalogListsObjectsAndPreservesKeyOrder(t *testing.T) {
+	c, schema := fixture(t)
+	ctx := context.Background()
+	tables, err := engine.Tables(ctx, c, []string{schema})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var names []string
+	for _, table := range tables {
+		names = append(names, table.Name+":"+table.Kind)
+	}
+	if !reflect.DeepEqual(names, []string{"item_summary:m", "item_view:v", "items:r", "parent:r"}) {
+		t.Fatalf("tables %v", names)
+	}
+	cs, err := engine.TableColumns(ctx, db.NewWorker(c), schema, "items")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(cs.PK, []string{"id"}) || !reflect.DeepEqual(cs.Unique, [][]string{{"code"}}) {
+		t.Errorf("row identity pk=%v unique=%v", cs.PK, cs.Unique)
+	}
+	if len(cs.Cols) != 8 || cs.Cols[2].Type != "numeric(12,2)" || !cs.Cols[7].Generated || !reflect.DeepEqual(cs.Cols[4].Enum, []string{"pending", "done"}) {
+		t.Errorf("columns %+v", cs.Cols)
+	}
+	parent, err := engine.TableColumns(ctx, c, schema, "parent")
+	if err != nil || !reflect.DeepEqual(parent.PK, []string{"b", "a"}) {
+		t.Errorf("composite primary key %v: %v", parent.PK, err)
+	}
+	keys, err := engine.Keys(ctx, c, schema, "items")
+	if err != nil {
+		t.Fatal(err)
+	}
+	fk := slices.IndexFunc(keys, func(k db.Key) bool { return k.Ref != nil })
+	if fk < 0 || !reflect.DeepEqual(keys[fk].Cols, []string{"b", "a"}) || !reflect.DeepEqual(keys[fk].Ref.Cols, []string{"b", "a"}) {
+		t.Errorf("foreign keys %+v", keys)
+	}
+	indexes, err := engine.Indexes(ctx, c, schema, "items")
+	if err != nil {
+		t.Fatal(err)
+	}
+	code := slices.IndexFunc(indexes, func(ix db.Index) bool { return ix.Name == "items_code" })
+	if code < 0 || !reflect.DeepEqual(indexes[code].Cols, []string{"code"}) {
+		t.Errorf("INCLUDE index %+v", indexes)
+	}
+	seqs, err := engine.Sequences(ctx, c, []string{schema})
+	if err != nil || !reflect.DeepEqual(seqs, []db.Sequence{{Schema: schema, Name: "item_seq"}}) {
+		t.Errorf("sequences %+v: %v", seqs, err)
+	}
+	if empty, err := engine.Tables(ctx, c, []string{}); err != nil || len(empty) != 0 {
+		t.Errorf("empty schema selection %+v: %v", empty, err)
+	}
+}
+
+func TestNativeDefinitionsRetainGeneratedColumnsAndFunctionBody(t *testing.T) {
+	c, schema := fixture(t)
+	ctx := context.Background()
+	def, err := engine.DDL(ctx, c, schema, "items")
+	if err != nil || !strings.Contains(strings.ToLower(def), "generated always") || !strings.Contains(def, "items_code") {
+		t.Fatalf("table DDL %q: %v", def, err)
+	}
+	for _, name := range []string{"item_view", "item_summary"} {
+		def, err := engine.DDL(ctx, c, schema, name)
+		if err != nil || !strings.Contains(def, name) || !strings.Contains(strings.ToLower(def), "select") {
+			t.Errorf("%s DDL %q: %v", name, def, err)
+		}
+	}
+	funcs, err := engine.Functions(ctx, c, []string{schema})
+	if err != nil || len(funcs) != 1 || funcs[0].Name != "sample" {
+		t.Fatalf("functions %+v: %v", funcs, err)
+	}
+	def, err = engine.FunctionDef(ctx, c, funcs[0])
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Executing the deparsed function proves record escaping did not alter its body.
+	query(t, c, def)
+	if got := query(t, c, "select sample()").Rows[0][0].S; got != "a\\b" {
+		t.Errorf("function body round trip %q", got)
+	}
+}
