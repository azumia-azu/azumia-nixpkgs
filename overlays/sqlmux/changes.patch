diff --git a/internal/db/gaussdb/catalog.go b/internal/db/gaussdb/catalog.go
new file mode 100644
index 0000000000..0967a155ba
--- /dev/null
+++ b/internal/db/gaussdb/catalog.go
@@ -0,0 +1,122 @@ func (Engine) Schemas(ctx context.Context, c db.Conn) (schemas []string, current
+package gaussdb
+
+import (
+	"context"
+	"encoding/json"
+	"strconv"
+
+	"github.com/kackerx/sqlmux/internal/db"
+	"github.com/kackerx/sqlmux/internal/sqlkit"
+)
+
+const userSchema = `n.nspname !~ '^pg_' and n.nspname not in ('information_schema', 'dbe_perf', 'db4ai', 'cstore', 'snapshot', 'blockchain', 'dbe_pldebugger', 'sqladvisor')`
+
+func (Engine) Schemas(ctx context.Context, c db.Conn) (schemas []string, current string, err error) {
+	r, err := c.Query(ctx, `select n.nspname, coalesce(current_schema(), '') from pg_namespace n where `+userSchema+` order by 1`)
+	if err != nil {
+		return nil, "", err
+	}
+	for _, row := range r.Rows {
+		schemas, current = append(schemas, row[0].S), row[1].S
+	}
+	return schemas, current, nil
+}
+
+func (Engine) Tables(ctx context.Context, c db.Conn, only []string) ([]db.Table, error) {
+	// GaussDB records partitions in pg_partition, not as pg_class children.
+	r, err := c.Query(ctx, `
+select n.nspname, c.relname, c.reltuples,
+       case when c.relkind = 'r' and c.parttype in ('p', 's') then 'p' else c.relkind end
+from pg_class c join pg_namespace n on n.oid = c.relnamespace
+where c.relkind in ('r', 'v', 'm', 'f') and `+userSchema+db.SchemaIn("n.nspname", only, sqlkit.PG)+`
+order by 1, 2`)
+	if err != nil {
+		return nil, err
+	}
+	ts := make([]db.Table, len(r.Rows))
+	for i, row := range r.Rows {
+		rows, err := strconv.ParseFloat(row[2].S, 64)
+		if err != nil {
+			return nil, err
+		}
+		ts[i] = db.Table{Schema: row[0].S, Name: row[1].S, Rows: rows, Kind: row[3].S}
+	}
+	return ts, nil
+}
+
+func (Engine) TableColumns(ctx context.Context, c db.Conn, schema, table string) (db.Columns, error) {
+	var out db.Columns
+	// Catalog fields are backported independently across GaussDB versions.
+	// Reading optional fields through JSON works over any db.Conn, including
+	// the app's Worker, without assuming its concrete driver connection.
+	identity := "coalesce(row_to_json(a)->>'attidentity', ' ')"
+	r, err := c.Query(ctx, `
+select a.attname, format_type(a.atttypid, a.atttypmod), a.attnotnull,
+       coalesce(pg_get_expr(d.adbin, d.adrelid), case `+identity+` when 'a' then 'generated always as identity' when 'd' then 'generated by default as identity' else '' end),
+       (select json_agg(e.enumlabel order by e.enumsortorder) from pg_enum e where e.enumtypid = a.atttypid),
+       d.adgencol = 's' or `+identity+` = 'a'
+from pg_attribute a
+join pg_class c on c.oid = a.attrelid
+join pg_namespace n on n.oid = c.relnamespace
+left join pg_attrdef d on d.adrelid = a.attrelid and d.adnum = a.attnum
+where n.nspname = $1 and c.relname = $2 and a.attnum > 0 and not a.attisdropped
+order by a.attnum`, db.Val{S: schema}, db.Val{S: table})
+	if err != nil {
+		return out, err
+	}
+	for _, row := range r.Rows {
+		col := db.Column{Name: row[0].S, Type: row[1].S, NotNull: row[2].S == "t", Default: row[3].S, Generated: row[5].S == "t"}
+		if !row[4].Null {
+			if err := json.Unmarshal([]byte(row[4].S), &col.Enum); err != nil {
+				return out, err
+			}
+		}
+		out.Cols = append(out.Cols, col)
+	}
+	return columnKeys(ctx, c, schema, table, out)
+}
+
+func columnKeys(ctx context.Context, c db.Conn, schema, table string, out db.Columns) (db.Columns, error) {
+	// int2vector starts at 0, constraint arrays at 1. generate_subscripts
+	// preserves both without relying on PostgreSQL's WITH ORDINALITY.
+	nkeys := "coalesce((row_to_json(i)->>'indnkeyatts')::int, i.indnatts)"
+	r, err := c.Query(ctx, `
+select con.contype, (
+    select json_agg(a.attname order by k.n)
+    from generate_subscripts(con.conkey, 1) k(n)
+    join pg_attribute a on a.attrelid = con.conrelid and a.attnum = con.conkey[k.n]), con.oid
+from pg_constraint con
+join pg_class c on c.oid = con.conrelid
+join pg_namespace n on n.oid = c.relnamespace
+where n.nspname = $1 and c.relname = $2 and con.contype = 'p'
+union all
+select 'u', (
+    select json_agg(a.attname order by k.n)
+    from generate_series(0, `+nkeys+` - 1) k(n)
+    join pg_attribute a on a.attrelid = i.indrelid and a.attnum = i.indkey[k.n]), i.indexrelid
+from pg_index i
+join pg_class c on c.oid = i.indrelid
+join pg_namespace n on n.oid = c.relnamespace
+where n.nspname = $1 and c.relname = $2
+  and i.indisunique and not i.indisprimary and i.indisvalid and i.indpred is null
+  and not exists (
+    select 1 from generate_series(0, `+nkeys+` - 1) k(n)
+    left join pg_attribute a on a.attrelid = i.indrelid and a.attnum = i.indkey[k.n]
+    where i.indkey[k.n] = 0 or not coalesce(a.attnotnull, false))
+order by 1, 3`, db.Val{S: schema}, db.Val{S: table})
+	if err != nil {
+		return out, err
+	}
+	for _, row := range r.Rows {
+		var cols []string
+		if err := json.Unmarshal([]byte(row[1].S), &cols); err != nil {
+			return out, err
+		}
+		if row[0].S == "p" {
+			out.PK = cols
+		} else {
+			out.Unique = append(out.Unique, cols)
+		}
+	}
+	return out, nil
+}
