diff --git a/internal/ui/formsegments.go b/internal/ui/formsegments.go
new file mode 100644
index 0000000000..f0164c2815
--- /dev/null
+++ b/internal/ui/formsegments.go
@@ -0,0 +1,34 @@ func (fd FormField) drawSegments(f *Frame, r uv.Rectangle, field int) {
+package ui
+
+import uv "github.com/charmbracelet/ultraviolet"
+
+// Keep the selected engine visible when its siblings no longer fit. The
+// original choice index is kept in hit targets, so mouse and keyboard agree.
+func (fd FormField) drawSegments(f *Frame, r uv.Rectangle, field int) {
+	start, used := 0, 0
+	for j, ch := range fd.Choices {
+		used += Width(ch) + 3
+		if j == fd.On {
+			break
+		}
+	}
+	for start < fd.On && used > r.Dx() {
+		used -= Width(fd.Choices[start]) + 3
+		start++
+	}
+	dim := uv.Style{Fg: f.Theme.Dim, Bg: f.Theme.PaneBg}
+	x := r.Min.X
+	for j := start; j < len(fd.Choices) && x < r.Max.X; j++ {
+		ch := fd.Choices[j]
+		st := uv.Style{Fg: f.Theme.Dim, Bg: f.Theme.Sep}
+		if j == fd.On {
+			st = uv.Style{Fg: f.Theme.Fg, Bg: f.Theme.Select}
+		}
+		if j > start {
+			x = f.Text(x, r.Min.Y, r.Max.X, "│", dim)
+		}
+		end := min(x+Width(ch)+2, r.Max.X)
+		f.Region(uv.Rect(x, r.Min.Y, end-x, 1), Target{Kind: KindSegment, Pane: field, I: j})
+		x = f.Text(x, r.Min.Y, r.Max.X, " "+ch+" ", st)
+	}
+}
diff --git a/internal/ui/formsegments_test.go b/internal/ui/formsegments_test.go
new file mode 100644
index 0000000000..31d9266dae
--- /dev/null
+++ b/internal/ui/formsegments_test.go
@@ -0,0 +1,35 @@ func TestSelectedFormSegmentRemainsVisibleAndClickable(t *testing.T) {
+package ui
+
+import (
+	"strings"
+	"testing"
+
+	uv "github.com/charmbracelet/ultraviolet"
+)
+
+func TestSelectedFormSegmentRemainsVisibleAndClickable(t *testing.T) {
+	choices := []string{"postgres", "mysql", "sqlite", "redis", "mssql", "gaussdb"}
+	for _, width := range []int{80, 120} {
+		for selected, name := range choices {
+			f := NewFrame(width, 15, TokyonightStorm)
+			form := Form{Save: "Save", Cancel: "Cancel", Fields: []FormField{
+				{Label: "engine", Kind: FormSegments, Choices: choices, On: selected},
+			}}
+			ConnManager{Title: "Connections", Rows: []ConnRow{{Name: "new"}}, Form: form}.Draw(f, f.Bounds())
+			if !strings.Contains(f.String(), " "+name+" ") {
+				t.Fatalf("%d columns: selected %s is clipped:\n%s", width, name, f.String())
+			}
+			found := false
+			for _, hit := range f.Hits {
+				if hit.Target.Kind == KindSegment && hit.Target.I == selected {
+					point := uv.Pos(hit.Rect.Min.X+1, hit.Rect.Min.Y)
+					target, ok := HitAt(f.Hits, point)
+					found = ok && target.Kind == KindSegment && target.I == selected
+				}
+			}
+			if !found {
+				t.Errorf("%d columns: selected %s cannot be clicked", width, name)
+			}
+		}
+	}
+}
