@@ -49,10 +49,10 @@ func pickable(n node) (dbs, ok bool) {
 	switch {
 	case n.kind == nodeConn && n.conn.Spec.Kind() == "mysql":
 		return false, true
-	case n.kind == nodeConn && (n.conn.Spec.Kind() == "postgres" || n.conn.Spec.Kind() == "mssql"):
+	case n.kind == nodeConn && (n.conn.Spec.Kind() == "postgres" || n.conn.Spec.Kind() == "gaussdb" || n.conn.Spec.Kind() == "mssql"):
 		return true, true
 	case n.kind == nodeDatabase:
-		return false, n.conn.Spec.Kind() == "postgres" || n.conn.Spec.Kind() == "mssql"
+		return false, n.conn.Spec.Kind() == "postgres" || n.conn.Spec.Kind() == "gaussdb" || n.conn.Spec.Kind() == "mssql"
 	}
 	return false, false
 }
