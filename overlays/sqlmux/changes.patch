diff --git a/internal/app/gaussdb_test.go b/internal/app/gaussdb_test.go
new file mode 100644
index 0000000000..98e19f7c19
--- /dev/null
+++ b/internal/app/gaussdb_test.go
@@ -0,0 +1,45 @@ func TestGaussDBFormCreatesSQLConnection(t *testing.T) {
+package app
+
+import (
+	"slices"
+	"testing"
+
+	"github.com/kackerx/sqlmux/internal/config"
+	"github.com/kackerx/sqlmux/internal/sqlkit"
+)
+
+func TestGaussDBFormCreatesSQLConnection(t *testing.T) {
+	t.Setenv("XDG_CONFIG_HOME", t.TempDir())
+	a, _ := withSessions()
+	a.openConnForm()
+	for field, value := range map[int]string{fieldName: "gauss", fieldHost: "db.example", fieldUser: "app", fieldDatabase: "sales"} {
+		a.form.fields[field].Input.Text = value
+	}
+	choices := a.form.fields[fieldEngine].Choices
+	a.formSegment(fieldEngine, slices.Index(choices, "gaussdb"))
+	spec, ok := a.formConn()
+	if !ok || spec.Engine != "gaussdb" || spec.DSN != "gaussdb://app@db.example:8000/sales?sslmode=prefer" {
+		t.Fatalf("form connection %+v: %s", spec, a.form.err)
+	}
+	spec.Databases, spec.Schemas = []string{"sales"}, []string{"sales.public"}
+	if field, problem := spec.Check(nil); problem != "" {
+		t.Fatalf("connection %s: %s", field, problem)
+	}
+	c := newConn(spec)
+	if !c.sql() || c.dialect() != sqlkit.PG {
+		t.Fatal("GaussDB does not initialize a PostgreSQL-family SQL engine")
+	}
+	for _, kind := range []nodeKind{nodeConn, nodeDatabase} {
+		dbs, ok := pickable(node{kind: kind, conn: c})
+		if !ok || dbs != (kind == nodeConn) {
+			t.Errorf("picker %v: databases=%v, enabled=%v", kind, dbs, ok)
+		}
+	}
+	if err := config.AppendConnection(spec); err != nil {
+		t.Fatal(err)
+	}
+	loaded, _, err := config.LoadConnections("gauss")
+	if err != nil || len(loaded) != 1 || loaded[0].DSN != spec.DSN || loaded[0].Engine != spec.Engine {
+		t.Fatalf("saved connection %+v: %v", loaded, err)
+	}
+}
