diff --git a/internal/db/gaussdb/error.go b/internal/db/gaussdb/error.go
new file mode 100644
index 0000000000..6f7c3188f9
--- /dev/null
+++ b/internal/db/gaussdb/error.go
@@ -0,0 +1,51 @@ func (Engine) ErrorOf(err error) db.ServerError {
+package gaussdb
+
+import (
+	"context"
+	"errors"
+	"strings"
+
+	"github.com/HuaweiCloudDeveloper/gaussdb-go/gaussdbconn"
+
+	"github.com/kackerx/sqlmux/internal/db"
+)
+
+var errClosed = errors.New("GaussDB connection closed")
+
+func (Engine) ErrorOf(err error) db.ServerError {
+	var pe *gaussdbconn.GaussdbError
+	if !errors.As(err, &pe) {
+		return db.ServerError{Severity: "ERROR", Message: err.Error()}
+	}
+	e := db.ServerError{Severity: pe.Severity, Code: pe.Code, Message: pe.Message, Position: int(pe.Position)}
+	for _, line := range [][2]string{{"DETAIL", pe.Detail}, {"HINT", pe.Hint}} {
+		if line[1] != "" {
+			e.More = append(e.More, strings.Split(line[0]+": "+line[1], "\n")...)
+		}
+	}
+	return e
+}
+
+func (Engine) Broken(err error) db.Lost {
+	var pe *gaussdbconn.GaussdbError
+	switch {
+	case errors.As(err, &pe):
+		if pe.Severity == "FATAL" || pe.Severity == "PANIC" || strings.HasPrefix(pe.Code, "08") {
+			return db.LostSent
+		}
+	case errors.Is(err, context.Canceled), errors.Is(err, context.DeadlineExceeded):
+		return db.NotLost
+	case errors.Is(err, errClosed):
+		return db.LostSent
+	case err.Error() == "conn closed":
+		// v1.0.0-rc1 does not export its connLockError sentinel. After a
+		// failed read it reports this retryable error, although a write
+		// may already have reached the server: never replay that write.
+		return db.LostSent
+	case gaussdbconn.SafeToRetry(err):
+		return db.LostUnsent
+	case db.NetworkError(err):
+		return db.LostSent
+	}
+	return db.NotLost
+}
diff --git a/internal/db/gaussdb/error_test.go b/internal/db/gaussdb/error_test.go
new file mode 100644
index 0000000000..b726552cac
--- /dev/null
+++ b/internal/db/gaussdb/error_test.go
@@ -0,0 +1,47 @@ func TestErrorOfPreservesSQLStateAndDetail(t *testing.T) {
+package gaussdb
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"reflect"
+	"testing"
+
+	"github.com/HuaweiCloudDeveloper/gaussdb-go/gaussdbconn"
+
+	"github.com/kackerx/sqlmux/internal/db"
+)
+
+func TestErrorOfPreservesSQLStateAndDetail(t *testing.T) {
+	err := fmt.Errorf("query: %w", &gaussdbconn.GaussdbError{
+		Severity: "ERROR", Code: "23505", Message: "duplicate key", Detail: "Key (id)=(1) already exists.", Hint: "Choose another id.", Position: 17,
+	})
+	want := db.ServerError{Severity: "ERROR", Code: "23505", Message: "duplicate key", Position: 17,
+		More: []string{"DETAIL: Key (id)=(1) already exists.", "HINT: Choose another id."}}
+	if got := (Engine{}).ErrorOf(err); !reflect.DeepEqual(got, want) {
+		t.Errorf("server error %+v, want %+v", got, want)
+	}
+}
+
+func TestBrokenDoesNotReplayPossiblySentWrites(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		err  error
+		want db.Lost
+	}{
+		{"closed before next call", errClosed, db.LostSent},
+		{"driver closed while reading", errors.New("conn closed"), db.LostSent},
+		{"reply lost", io.EOF, db.LostSent},
+		{"server shutdown", &gaussdbconn.GaussdbError{Severity: "FATAL", Code: "57P01"}, db.LostSent},
+		{"connection exception", &gaussdbconn.GaussdbError{Severity: "ERROR", Code: "08006"}, db.LostSent},
+		{"constraint violation", &gaussdbconn.GaussdbError{Severity: "ERROR", Code: "23505"}, db.NotLost},
+		{"cancel", context.Canceled, db.NotLost},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := (Engine{}).Broken(tc.err); got != tc.want {
+				t.Errorf("lost = %v, want %v", got, tc.want)
+			}
+		})
+	}
+}
diff --git a/internal/db/gaussdb/gaussdb.go b/internal/db/gaussdb/gaussdb.go
new file mode 100644
index 0000000000..df88b83c4c
--- /dev/null
+++ b/internal/db/gaussdb/gaussdb.go
@@ -0,0 +1,99 @@ type Conn struct {
+// Package gaussdb adapts the native GaussDB wire driver to sqlmux's text protocol.
+package gaussdb
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/HuaweiCloudDeveloper/gaussdb-go/gaussdbconn"
+	"github.com/HuaweiCloudDeveloper/gaussdb-go/gaussdbconn/ctxwatch"
+
+	"github.com/kackerx/sqlmux/internal/db"
+	"github.com/kackerx/sqlmux/internal/db/postgres"
+)
+
+// Engine shares PostgreSQL SQL semantics, but uses GaussDB authentication and catalogs.
+type Engine struct{ postgres.Engine }
+
+type Conn struct {
+	pg *gaussdbconn.GaussdbConn
+}
+
+func (Engine) Connect(ctx context.Context, dsn, password string, readOnly bool) (db.Conn, db.Info, error) {
+	c, info, err := Connect(ctx, dsn, password, readOnly)
+	if err != nil {
+		return nil, db.Info{}, err
+	}
+	return c, info, nil
+}
+
+func Connect(ctx context.Context, dsn, password string, readOnly bool) (*Conn, db.Info, error) {
+	cfg, err := gaussdbconn.ParseConfig(normalizeDSN(dsn))
+	if err != nil {
+		return nil, db.Info{}, err
+	}
+	if password != "" {
+		cfg.Password = password
+	}
+	if _, ok := cfg.RuntimeParams["application_name"]; !ok {
+		cfg.RuntimeParams["application_name"] = "sqlmux"
+	}
+	if cfg.ConnectTimeout == 0 {
+		cfg.ConnectTimeout = 10 * time.Second
+	}
+	cfg.RuntimeParams["DateStyle"] = "ISO, YMD"
+	if readOnly {
+		cfg.RuntimeParams["default_transaction_read_only"] = "on"
+	}
+	cfg.BuildContextWatcherHandler = func(pg *gaussdbconn.GaussdbConn) ctxwatch.Handler {
+		return &gaussdbconn.CancelRequestContextWatcherHandler{Conn: pg, DeadlineDelay: 5 * time.Second}
+	}
+	if d, ok := db.DialerOf(ctx); ok {
+		cfg.DialFunc = gaussdbconn.DialFunc(d.Dial)
+		cfg.LookupFunc = func(_ context.Context, host string) ([]string, error) { return []string{host}, nil }
+	}
+	pg, err := gaussdbconn.ConnectConfig(ctx, cfg)
+	if err != nil {
+		return nil, db.Info{}, err
+	}
+	c := &Conn{pg: pg}
+	r, err := c.Query(ctx, "select current_setting('search_path'), current_database()")
+	if err != nil {
+		c.Close()
+		return nil, db.Info{}, err
+	}
+	return c, db.Info{Addr: fmt.Sprintf("%s@%s:%d", cfg.User, cfg.Host, cfg.Port), Database: r.Rows[0][1].S, Path: r.Rows[0][0].S}, nil
+}
+
+func normalizeDSN(dsn string) string {
+	for _, prefix := range []string{"postgres://", "postgresql://", "opengauss://"} {
+		if strings.HasPrefix(dsn, prefix) {
+			return "gaussdb://" + strings.TrimPrefix(dsn, prefix)
+		}
+	}
+	return dsn
+}
+
+func WithDatabase(dsn, name string) (string, error) {
+	// Reuse the URL/keyword handling, including query parameters that override dbname.
+	dsn = normalizeDSN(dsn)
+	if strings.HasPrefix(dsn, "gaussdb://") {
+		next, err := postgres.WithDatabase("postgres://"+strings.TrimPrefix(dsn, "gaussdb://"), name)
+		if err != nil {
+			return "", err
+		}
+		return normalizeDSN(next), nil
+	}
+	return postgres.WithDatabase(dsn, name)
+}
+
+func (c *Conn) Close() error { return c.pg.Close(context.Background()) }
+func (c *Conn) Closed() bool { return c.pg.IsClosed() }
+func (c *Conn) TxStatus() byte {
+	if c.Closed() {
+		return 'I'
+	}
+	return c.pg.TxStatus()
+}
diff --git a/internal/db/gaussdb/gaussdb_test.go b/internal/db/gaussdb/gaussdb_test.go
new file mode 100644
index 0000000000..814e9de60d
--- /dev/null
+++ b/internal/db/gaussdb/gaussdb_test.go
@@ -0,0 +1,57 @@ func connect(t *testing.T, readOnly bool) *Conn {
+//go:build integration
+
+package gaussdb
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/kackerx/sqlmux/internal/db"
+)
+
+func connect(t *testing.T, readOnly bool) *Conn {
+	t.Helper()
+	dsn := os.Getenv("SQLMUX_TEST_GAUSSDB")
+	if dsn == "" {
+		t.Skip("SQLMUX_TEST_GAUSSDB is not set")
+	}
+	for _, kv := range os.Environ() {
+		if key, _, _ := strings.Cut(kv, "="); strings.HasPrefix(key, "GAUSSDB_") {
+			t.Setenv(key, "")
+		}
+	}
+	t.Setenv("GAUSSDB_PASSFILE", filepath.Join(t.TempDir(), "none"))
+	c, _, err := Connect(context.Background(), dsn, "", readOnly)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { c.Close() })
+	return c
+}
+
+func query(t *testing.T, c db.Conn, sql string, args ...db.Val) db.Result {
+	t.Helper()
+	r, err := c.Query(context.Background(), sql, args...)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return r
+}
+
+func TestConnectReturnsServerText(t *testing.T) {
+	c := connect(t, false)
+	r := query(t, c, `select $1::numeric(12,2), $2::text, $3::text, current_setting('DateStyle'), current_setting('application_name')`,
+		db.Val{S: "1.50"}, db.Val{S: "text"}, db.Val{Null: true})
+	want := []db.Val{{S: "1.50"}, {S: "text"}, {Null: true}, {S: "ISO, YMD"}, {S: "sqlmux"}}
+	for i, v := range want {
+		if r.Rows[0][i] != v {
+			t.Errorf("column %d = %+v, want %+v", i, r.Rows[0][i], v)
+		}
+	}
+	if r.Cols[0].Type != "numeric" || c.TxStatus() != 'I' {
+		t.Fatalf("columns %v, transaction %c", r.Cols, c.TxStatus())
+	}
+}
diff --git a/internal/db/gaussdb/network_test.go b/internal/db/gaussdb/network_test.go
new file mode 100644
index 0000000000..a71e227065
--- /dev/null
+++ b/internal/db/gaussdb/network_test.go
@@ -0,0 +1,57 @@ func TestSSHTunnelCarriesAuthenticationQueriesAndCancellation(t *testing.T) {
+//go:build integration
+
+package gaussdb
+
+import (
+	"context"
+	"os"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/kackerx/sqlmux/internal/db"
+)
+
+func TestSSHTunnelCarriesAuthenticationQueriesAndCancellation(t *testing.T) {
+	// connect clears the driver's ambient configuration before the tunnel test.
+	connect(t, true)
+	dsn := os.Getenv("SQLMUX_TEST_GAUSSDB")
+	db.NCSSH(t)
+	dsn = strings.ReplaceAll(dsn, "localhost", "db.internal.invalid")
+	ctx := db.WithDialer(context.Background(), db.SSHDialer("app@jump"))
+	c, _, err := Connect(ctx, dsn, "", false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	query(t, c, "select 1")
+	cancelCtx, cancel := context.WithTimeout(ctx, 200*time.Millisecond)
+	defer cancel()
+	if _, err := c.Query(cancelCtx, "select pg_sleep(30)"); err == nil || engine.ErrorOf(err).Code != "57014" {
+		t.Fatalf("cancellation through tunnel: %v", err)
+	}
+	if got := query(t, c, "select 2").Rows[0][0].S; got != "2" {
+		t.Errorf("after tunneled cancellation: %q", got)
+	}
+}
+
+func TestWorkerReconnectsAfterServerTerminatesBackend(t *testing.T) {
+	c := connect(t, false)
+	admin := connect(t, false)
+	ctx := context.Background()
+	pid := query(t, c, "select pg_backend_pid()").Rows[0][0]
+	w := db.NewWorker(c)
+	w.Broken = engine.Broken
+	w.Redial = func(ctx context.Context) (db.Conn, error) {
+		next, _, err := Connect(ctx, os.Getenv("SQLMUX_TEST_GAUSSDB"), "", false)
+		return next, err
+	}
+	defer w.Close()
+	if got := query(t, admin, "select pg_terminate_backend($1::bigint)", pid).Rows[0][0].S; got != "t" {
+		t.Fatalf("backend termination %q", got)
+	}
+	r, err := w.Query(ctx, "select 42")
+	if err != nil || len(r.Rows) != 1 || r.Rows[0][0].S != "42" {
+		t.Fatalf("query after reconnection %+v: %v", r, err)
+	}
+}
diff --git a/internal/db/gaussdb/objects.go b/internal/db/gaussdb/objects.go
new file mode 100644
index 0000000000..b9b529c1b1
--- /dev/null
+++ b/internal/db/gaussdb/objects.go
@@ -0,0 +1,172 @@ func (e Engine) DDL(ctx context.Context, c db.Conn, schema, name string) (string
+package gaussdb
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"strings"
+
+	"github.com/kackerx/sqlmux/internal/db"
+	"github.com/kackerx/sqlmux/internal/i18n"
+	"github.com/kackerx/sqlmux/internal/sqlkit"
+)
+
+func (e Engine) DDL(ctx context.Context, c db.Conn, schema, name string) (string, error) {
+	rel := db.Val{S: e.Quote(schema, name)}
+	r, err := c.Query(ctx, "select relkind from pg_class where oid = $1::regclass", rel)
+	if err != nil {
+		return "", err
+	}
+	if r.Rows[0][0].S == "v" || r.Rows[0][0].S == "m" {
+		kind := "view"
+		if r.Rows[0][0].S == "m" {
+			kind = "materialized view"
+		}
+		r, err = c.Query(ctx, "select pg_get_viewdef($1::regclass, true)", rel)
+		if err != nil {
+			return "", err
+		}
+		def := "create " + kind + " " + rel.S + " as\n" + r.Rows[0][0].S
+		if kind == "materialized view" {
+			indexes, err := e.Indexes(ctx, c, schema, name)
+			if err != nil {
+				return "", err
+			}
+			for _, index := range indexes {
+				def += "\n" + index.Def
+			}
+		}
+		notes, err := c.Query(ctx, `
+select null::text, quote_literal(obj_description($1::regclass, 'pg_class')), 0
+where obj_description($1::regclass, 'pg_class') is not null
+union all
+select quote_ident(a.attname), quote_literal(col_description(a.attrelid, a.attnum)), a.attnum
+from pg_attribute a
+where a.attrelid = $1::regclass and a.attnum > 0 and not a.attisdropped and col_description(a.attrelid, a.attnum) is not null
+order by 3`, rel)
+		if err != nil {
+			return "", err
+		}
+		for _, note := range notes.Rows {
+			if note[0].Null {
+				def += "\ncomment on " + kind + " " + rel.S + " is " + note[1].S + ";"
+			} else {
+				def += "\ncomment on column " + rel.S + "." + note[0].S + " is " + note[1].S + ";"
+			}
+		}
+		return def, nil
+	}
+	// The native deparser retains GaussDB partitioning and storage options.
+	r, err = c.Query(ctx, "select pg_get_tabledef($1::text)", rel)
+	if err != nil {
+		return "", err
+	}
+	return r.Rows[0][0].S, nil
+}
+
+func (Engine) Indexes(ctx context.Context, c db.Conn, schema, table string) ([]db.Index, error) {
+	r, err := c.Query(ctx, `
+select ic.relname, ix.indisunique, pg_get_indexdef(ix.indexrelid),
+       (select json_agg(pg_get_indexdef(ix.indexrelid, k, true) order by k)
+        from generate_series(1, coalesce((row_to_json(ix)->>'indnkeyatts')::int, ix.indnatts)) k)
+from pg_index ix
+join pg_class ic on ic.oid = ix.indexrelid
+join pg_class c on c.oid = ix.indrelid
+join pg_namespace n on n.oid = c.relnamespace
+where n.nspname = $1 and c.relname = $2
+order by ic.relname`, db.Val{S: schema}, db.Val{S: table})
+	if err != nil {
+		return nil, err
+	}
+	var out []db.Index
+	for _, row := range r.Rows {
+		ix := db.Index{Name: row[0].S, Unique: row[1].S == "t", Def: row[2].S + ";"}
+		if err := json.Unmarshal([]byte(row[3].S), &ix.Cols); err != nil {
+			return nil, err
+		}
+		out = append(out, ix)
+	}
+	return out, nil
+}
+
+func (Engine) Keys(ctx context.Context, c db.Conn, schema, table string) ([]db.Key, error) {
+	r, err := c.Query(ctx, `
+select con.conname, con.contype, rn.nspname, rc.relname,
+       (select json_agg(a.attname order by k.n)
+        from generate_subscripts(con.conkey, 1) k(n)
+        join pg_attribute a on a.attrelid = con.conrelid and a.attnum = con.conkey[k.n]),
+       (select json_agg(a.attname order by k.n)
+        from generate_subscripts(con.confkey, 1) k(n)
+        join pg_attribute a on a.attrelid = con.confrelid and a.attnum = con.confkey[k.n])
+from pg_constraint con
+join pg_class c on c.oid = con.conrelid
+join pg_namespace n on n.oid = c.relnamespace
+left join pg_class rc on rc.oid = con.confrelid
+left join pg_namespace rn on rn.oid = rc.relnamespace
+where n.nspname = $1 and c.relname = $2 and con.contype in ('p', 'f')
+order by con.contype, con.conname`, db.Val{S: schema}, db.Val{S: table})
+	if err != nil {
+		return nil, err
+	}
+	var out []db.Key
+	for _, row := range r.Rows {
+		key := db.Key{Name: row[0].S}
+		if err := json.Unmarshal([]byte(row[4].S), &key.Cols); err != nil {
+			return nil, err
+		}
+		if row[1].S == "f" {
+			key.Ref = &db.Ref{Schema: row[2].S, Table: row[3].S}
+			if err := json.Unmarshal([]byte(row[5].S), &key.Ref.Cols); err != nil {
+				return nil, err
+			}
+		}
+		out = append(out, key)
+	}
+	return out, nil
+}
+
+func (Engine) Functions(ctx context.Context, c db.Conn, only []string) ([]db.Function, error) {
+	r, err := c.Query(ctx, `
+select n.nspname, p.proname, pg_get_function_identity_arguments(p.oid), p.oid::text
+from pg_proc p join pg_namespace n on n.oid = p.pronamespace
+where not p.proisagg and not p.proiswindow and `+userSchema+db.SchemaIn("n.nspname", only, sqlkit.PG)+`
+  and not exists (select 1 from pg_depend d where d.classid = 'pg_proc'::regclass and d.objid = p.oid and d.deptype = 'e')
+order by 1, 2, 3`)
+	if err != nil {
+		return nil, err
+	}
+	out := make([]db.Function, len(r.Rows))
+	for i, row := range r.Rows {
+		out[i] = db.Function{Schema: row[0].S, Name: row[1].S, Args: row[2].S, ID: row[3].S}
+	}
+	return out, nil
+}
+
+func (Engine) FunctionDef(ctx context.Context, c db.Conn, f db.Function) (string, error) {
+	// GaussDB returns (headerlines, definition), not PostgreSQL's scalar
+	// text. Selecting the record itself would escape the function body.
+	r, err := c.Query(ctx, "select definition from pg_get_functiondef($1::oid)", db.Val{S: f.ID})
+	if err != nil {
+		return "", err
+	}
+	if len(r.Rows) == 0 || r.Rows[0][0].Null {
+		return "", errors.New(i18n.T("函数已不存在，按 R 刷新"))
+	}
+	return strings.TrimRight(r.Rows[0][0].S, "; \t\r\n") + ";", nil
+}
+
+func (Engine) Sequences(ctx context.Context, c db.Conn, only []string) ([]db.Sequence, error) {
+	r, err := c.Query(ctx, `
+select n.nspname, cl.relname
+from pg_class cl join pg_namespace n on n.oid = cl.relnamespace
+where cl.relkind in ('S', 'L') and `+userSchema+db.SchemaIn("n.nspname", only, sqlkit.PG)+`
+order by 1, 2`)
+	if err != nil {
+		return nil, err
+	}
+	out := make([]db.Sequence, len(r.Rows))
+	for i, row := range r.Rows {
+		out[i] = db.Sequence{Schema: row[0].S, Name: row[1].S}
+	}
+	return out, nil
+}
diff --git a/internal/db/gaussdb/partition_test.go b/internal/db/gaussdb/partition_test.go
new file mode 100644
index 0000000000..11f72a87fc
--- /dev/null
+++ b/internal/db/gaussdb/partition_test.go
@@ -0,0 +1,37 @@ func TestPartitionParentAndNativeDefinition(t *testing.T) {
+//go:build integration
+
+package gaussdb
+
+import (
+	"context"
+	"strings"
+	"testing"
+)
+
+func TestPartitionParentAndNativeDefinition(t *testing.T) {
+	c, schema := fixture(t)
+	query(t, c, `create table events (id int, day date)
+with (storage_type=astore) partition by range(day) (
+partition before_2026 values less than ('2026-01-01'),
+partition later values less than (maxvalue))`)
+	tables, err := engine.Tables(context.Background(), c, []string{schema})
+	if err != nil {
+		t.Fatal(err)
+	}
+	found := 0
+	for _, table := range tables {
+		if table.Name == "events" && table.Kind == "p" {
+			found++
+		}
+		if table.Name == "before_2026" || table.Name == "later" {
+			t.Errorf("partition listed as table: %s", table.Name)
+		}
+	}
+	if found != 1 {
+		t.Fatalf("partition parent listed %d times", found)
+	}
+	def, err := engine.DDL(context.Background(), c, schema, "events")
+	if err != nil || !strings.Contains(strings.ToLower(def), "partition by range") {
+		t.Fatalf("partition DDL %q: %v", def, err)
+	}
+}
diff --git a/internal/db/gaussdb/rows.go b/internal/db/gaussdb/rows.go
new file mode 100644
index 0000000000..052d5c7120
--- /dev/null
+++ b/internal/db/gaussdb/rows.go
@@ -0,0 +1,100 @@ func (c *Conn) Exec(ctx context.Context, sql string, maxRows int) ([]db.Result, 
+package gaussdb
+
+import (
+	"context"
+	"time"
+
+	"github.com/HuaweiCloudDeveloper/gaussdb-go/gaussdbconn"
+	"github.com/jackc/pgx/v5/pgtype"
+
+	"github.com/kackerx/sqlmux/internal/db"
+)
+
+var types = pgtype.NewMap()
+
+func (c *Conn) Exec(ctx context.Context, sql string, maxRows int) ([]db.Result, error) {
+	if c.Closed() {
+		return nil, errClosed
+	}
+	var out []db.Result
+	start := time.Now()
+	mrr := c.pg.Exec(ctx, sql)
+	for mrr.NextResult() {
+		r, err := readResult(mrr.ResultReader(), maxRows, start)
+		if err != nil {
+			mrr.Close()
+			return out, err
+		}
+		out = append(out, r)
+		start = time.Now()
+	}
+	return out, mrr.Close()
+}
+
+func (c *Conn) Query(ctx context.Context, sql string, args ...db.Val) (db.Result, error) {
+	if c.Closed() {
+		return db.Result{}, errClosed
+	}
+	params := make([][]byte, len(args))
+	for i, a := range args {
+		if !a.Null {
+			params[i] = []byte(a.S)
+		}
+	}
+	return readResult(c.pg.ExecParams(ctx, sql, params, nil, nil, nil), 0, time.Now())
+}
+
+func (c *Conn) Stream(ctx context.Context, sql string, head func([]db.Col) error, row func([]db.Val) error) error {
+	if c.Closed() {
+		return errClosed
+	}
+	ctx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	_, err := each(c.pg.ExecParams(ctx, sql, nil, nil, nil, nil), cancel, head, func() bool { return true }, row)
+	return err
+}
+
+func readResult(rr *gaussdbconn.ResultReader, maxRows int, start time.Time) (db.Result, error) {
+	var r db.Result
+	tag, err := each(rr, nil, func(cols []db.Col) error { r.Cols = cols; return nil }, db.Capped(&r, maxRows),
+		func(vals []db.Val) error { r.Rows = append(r.Rows, vals); return nil })
+	r.Tag, r.Affected, r.Took = tag.String(), tag.RowsAffected(), time.Since(start)
+	return r, err
+}
+
+// Every value stays in the server's text representation, including numeric
+// scale, JSON whitespace and NULL. Draining capped results preserves writes.
+func each(rr *gaussdbconn.ResultReader, stop func(), head func([]db.Col) error, want func() bool, row func([]db.Val) error) (gaussdbconn.CommandTag, error) {
+	var cols []db.Col
+	for _, f := range rr.FieldDescriptions() {
+		col := db.Col{Name: f.Name}
+		if t, ok := types.TypeForOID(f.DataTypeOID); ok {
+			col.Type = t.Name
+		}
+		cols = append(cols, col)
+	}
+	err := head(cols)
+	if err != nil && len(cols) == 0 {
+		if _, cerr := rr.Close(); cerr != nil {
+			return gaussdbconn.CommandTag{}, cerr
+		}
+	}
+	for err == nil && rr.NextRow() {
+		if !want() {
+			continue
+		}
+		vals := make([]db.Val, len(cols))
+		for i, v := range rr.Values() {
+			vals[i] = db.Val{S: string(v), Null: v == nil}
+		}
+		err = row(vals)
+	}
+	if err != nil {
+		if stop != nil {
+			stop()
+		}
+		_, _ = rr.Close()
+		return gaussdbconn.CommandTag{}, err
+	}
+	return rr.Close()
+}
diff --git a/internal/db/gaussdb/save_test.go b/internal/db/gaussdb/save_test.go
new file mode 100644
index 0000000000..7a9873652a
--- /dev/null
+++ b/internal/db/gaussdb/save_test.go
@@ -0,0 +1,59 @@ func TestSaveUpdatesInsertsDeletesAndRejectsStaleRows(t *testing.T) {
+//go:build integration
+
+package gaussdb
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/kackerx/sqlmux/internal/db"
+)
+
+func TestSaveUpdatesInsertsDeletesAndRejectsStaleRows(t *testing.T) {
+	c, schema := fixture(t)
+	ctx := context.Background()
+	w := db.NewWorker(c)
+	ch := db.Changes{
+		Deletes: [][]string{{"2"}},
+		Updates: []db.Row{{Key: []string{"1"}, Cols: []db.Change{{Name: "note", Old: db.Val{S: "before"}, Val: db.Val{S: "after"}}}}},
+		Inserts: [][]db.Change{{{Name: "id", Val: db.Val{S: "3"}}, {Name: "code", Val: db.Val{S: "third"}}}},
+	}
+	if failed, tx, err := db.Save(ctx, w, engine, schema, "items", []string{"id"}, ch, false); err != nil || tx != 'I' {
+		t.Fatalf("save statement %d, tx %c: %v", failed, tx, err)
+	}
+	page, _, err := db.Page(ctx, c, engine, db.Query{Schema: schema, Table: "items", Key: []string{"id"}, Limit: 10})
+	if err != nil || len(page.Rows) != 2 || page.Rows[0][3].S != "after" || page.Rows[1][0].S != "3" {
+		t.Fatalf("saved page %+v: %v", page, err)
+	}
+	// Another writer changed the old cell. The batch's preceding delete must
+	// roll back together with the conflicting update.
+	stale := db.Changes{Deletes: [][]string{{"3"}}, Updates: ch.Updates}
+	if _, _, err := db.Save(ctx, w, engine, schema, "items", []string{"id"}, stale, false); !errors.Is(err, db.ErrStale) {
+		t.Fatalf("stale save %v", err)
+	}
+	if got := query(t, c, "select count(*) from "+engine.Quote(schema, "items")).Rows[0][0].S; got != "2" {
+		t.Errorf("partial batch committed: %s rows", got)
+	}
+}
+
+func TestManualSaveStaysUncommittedUntilRollback(t *testing.T) {
+	c, schema := fixture(t)
+	ctx := context.Background()
+	w := db.NewWorker(c)
+	ch := db.Changes{Updates: []db.Row{{Key: []string{"1"}, Cols: []db.Change{{Name: "note", Old: db.Val{S: "before"}, Val: db.Val{S: "manual"}}}}}}
+	if _, tx, err := db.Save(ctx, w, engine, schema, "items", []string{"id"}, ch, true); err != nil || tx != 'T' {
+		t.Fatalf("manual save tx %c: %v", tx, err)
+	}
+	reader := connect(t, true)
+	sql := "select note from " + engine.Quote(schema, "items") + " where id = 1"
+	if got := query(t, reader, sql).Rows[0][0].S; got != "before" {
+		t.Fatalf("manual write visible before commit: %q", got)
+	}
+	if _, err := db.End(ctx, c, "rollback"); err != nil {
+		t.Fatal(err)
+	}
+	if got := query(t, c, sql).Rows[0][0].S; got != "before" {
+		t.Errorf("rollback retained %q", got)
+	}
+}
diff --git a/internal/db/gaussdb/transport_test.go b/internal/db/gaussdb/transport_test.go
new file mode 100644
index 0000000000..82e0eee0b5
--- /dev/null
+++ b/internal/db/gaussdb/transport_test.go
@@ -0,0 +1,115 @@ func TestExecDrainsCappedResultsAndKeepsFollowingStatements(t *testing.T) {
+//go:build integration
+
+package gaussdb
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/kackerx/sqlmux/internal/db"
+)
+
+func TestExecDrainsCappedResultsAndKeepsFollowingStatements(t *testing.T) {
+	c := connect(t, false)
+	results, err := c.Exec(context.Background(), "select generate_series(1, 4) as n; select 'last' as marker", 2)
+	if err != nil || len(results) != 2 {
+		t.Fatalf("results %+v: %v", results, err)
+	}
+	if len(results[0].Rows) != 2 || !results[0].Truncated || results[1].Rows[0][0].S != "last" {
+		t.Errorf("capped results %+v", results)
+	}
+}
+
+func TestStreamCancellationLeavesConnectionUsable(t *testing.T) {
+	c := connect(t, false)
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	rows := 0
+	err := c.Stream(ctx, "select generate_series(1, 100000000)", func(cols []db.Col) error {
+		if len(cols) != 1 || cols[0].Type != "int4" {
+			t.Errorf("columns %+v", cols)
+		}
+		return nil
+	}, func([]db.Val) error {
+		rows++
+		if rows == 17 {
+			cancel()
+		}
+		return nil
+	})
+	if err == nil {
+		t.Fatal("stream ran to completion after cancellation")
+	}
+	if got := query(t, c, "select 42").Rows[0][0].S; got != "42" {
+		t.Errorf("after cancellation %q", got)
+	}
+}
+
+func TestStreamCallbackFailureReturnsOriginalError(t *testing.T) {
+	c := connect(t, false)
+	want := errors.New("export destination closed")
+	err := c.Stream(context.Background(), "select generate_series(1, 100000000)",
+		func([]db.Col) error { return nil }, func([]db.Val) error { return want })
+	if !errors.Is(err, want) {
+		t.Fatalf("stream error %v", err)
+	}
+	query(t, c, "select 1")
+}
+
+func TestQueryTimeoutCancelsServerWork(t *testing.T) {
+	c := connect(t, false)
+	ctx, cancel := context.WithTimeout(context.Background(), 200*time.Millisecond)
+	defer cancel()
+	_, err := c.Query(ctx, "select pg_sleep(30)")
+	if err == nil || engine.ErrorOf(err).Code != "57014" {
+		t.Fatalf("server cancellation %v", err)
+	}
+	query(t, c, "select 1")
+}
+
+func TestReadOnlyConnectionRejectsServerWrites(t *testing.T) {
+	writer, schema := fixture(t)
+	reader := connect(t, true)
+	_, err := reader.Query(context.Background(), "insert into "+engine.Quote(schema, "items")+"(id, code) values (9, 'forbidden')")
+	if err == nil || engine.ErrorOf(err).Code != "25006" {
+		t.Fatalf("read-only insert %v", err)
+	}
+	if got := query(t, writer, "select count(*) from "+engine.Quote(schema, "items")).Rows[0][0].S; got != "2" {
+		t.Errorf("read-only connection changed the table: %s rows", got)
+	}
+}
+
+func TestFailedTransactionRollsBackAndRecovers(t *testing.T) {
+	c := connect(t, false)
+	query(t, c, "begin")
+	if c.TxStatus() != 'T' {
+		t.Fatalf("after begin %c", c.TxStatus())
+	}
+	_, err := c.Query(context.Background(), "select 1/0")
+	if err == nil || c.TxStatus() != 'E' {
+		t.Fatalf("failed transaction %c: %v", c.TxStatus(), err)
+	}
+	if tag, err := db.End(context.Background(), c, "rollback"); err != nil || tag != "ROLLBACK" || c.TxStatus() != 'I' {
+		t.Fatalf("rollback %q, status %c: %v", tag, c.TxStatus(), err)
+	}
+	query(t, c, "select 1")
+}
+
+func TestSchemaSwitchAndReadOnlyQuickQuery(t *testing.T) {
+	c, schema := fixture(t)
+	query(t, c, "set search_path to public")
+	ctx := context.Background()
+	if err := engine.UseSchema(ctx, c, schema, "public"); err != nil {
+		t.Fatal(err)
+	}
+	if got := query(t, c, "select current_schema()").Rows[0][0].S; got != schema {
+		t.Fatalf("current schema %q", got)
+	}
+	w := db.NewWorker(c)
+	r, err := engine.Quick(ctx, w, "select * from items order by id", schema, 1)
+	if err != nil || len(r.Rows) != 1 || !r.Truncated || c.TxStatus() != 'I' {
+		t.Fatalf("quick query %+v, status %c: %v", r, c.TxStatus(), err)
+	}
+}
